# Unified AI Assistant - Environment Configuration Template
# IMPORTANT: Never commit actual API keys or secrets to version control.
# Copy this file to .env for local development.

# Server Configuration
API_HOST=127.0.0.1
API_PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Hosted AI Provider API Keys (Server-side ONLY; Never expose to client applications)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

