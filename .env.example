# Unified AI Assistant - Environment Configuration Template
# IMPORTANT: Never commit actual API keys or secrets to version control.
# Copy this file to .env for local development.

# Server Configuration
API_HOST=127.0.0.1
API_PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database Persistence (Phase 2)
# PostgreSQL production/container:
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/unified_ai
# Default local development fallback:
DATABASE_URL=sqlite+aiosqlite:///unified_ai.db

# Development Identity Boundary
DEV_USER_ID=dev-user-default

# Hosted AI Provider API Keys (Server-side ONLY; Never expose to client applications)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Optional Default Provider & Model
DEFAULT_PROVIDER=
DEFAULT_MODEL=

# Future Services (Phase 4 / 5 / 6)
# REDIS_URL=redis://localhost:6379/0
# CHROME_CDP_ENDPOINT=http://127.0.0.1:9222
