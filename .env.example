# ==============================================================================
# Unified AI Assistant - Local Development Environment Template
# ==============================================================================
# IMPORTANT: Never commit actual API keys, credentials, or secrets to Git.
# Copy this file to .env (or services/api/.env) for local development overrides.

# --- Server & Environment ---
API_HOST=127.0.0.1
API_PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Authentication & Identity ---
AUTH_MODE=dev_fallback
ALLOW_DEV_AUTH=true
DEV_USER_ID=dev-user-default
# JWT secret is required in production (min 32 chars). Optional in development:
# JWT_SECRET_KEY=replace_with_at_least_32_characters_for_jwt_auth
# JWT_ALGORITHM=HS256

# --- Database Persistence ---
# Default local development fallback (SQLite with WAL mode):
DATABASE_URL=sqlite+aiosqlite:///unified_ai.db
# PostgreSQL (local or container):
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/unified_ai

# --- Hosted AI Provider API Keys (Server-side ONLY) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Default Provider & Model Selection
DEFAULT_PROVIDER=gemini
DEFAULT_MODEL=gemini-3.8-flash
FALLBACK_MODEL=gemini-3.5-flash-lite

# --- Web Research Search Providers (Optional) ---
TAVILY_API_KEY=
PERPLEXITY_API_KEY=

# --- Autonomous Browser Agent ---
BROWSER_HEADLESS=true
ALLOW_LOCAL_BROWSER_TARGETS=false
BROWSER_WORKER_CONCURRENCY=3

# --- Files & Knowledge Storage ---
STORAGE_DIR=services/api/data/storage
MAX_UPLOAD_SIZE_BYTES=20971520
MAX_USER_STORAGE_BYTES=104857600
MAX_USER_FILE_COUNT=50

# --- Environmental & Wi-Fi Sensing ---
ENABLE_SIMULATED_SENSING=true

# --- Network Ingress & Limits ---
RATE_LIMIT_PER_MINUTE=120
MAX_REQUEST_BODY_BYTES=15728640
