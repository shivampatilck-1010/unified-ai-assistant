# Unified AI Assistant - Backend API Environment Variables
# Copy to .env in services/api for local development.

HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database Persistence
# For PostgreSQL (production/container):
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/unified_ai
# Default local development fallback:
DATABASE_URL=sqlite+aiosqlite:///unified_ai.db

# Development Identity Boundary
DEV_USER_ID=dev-user-default

# Configure both values to enable verified Google sign-in locally.
JWT_SECRET_KEY=replace_with_a_random_32_byte_hex_secret
GOOGLE_CLIENT_ID=your-oauth-client-id.apps.googleusercontent.com

# Hosted Model Keys (Server-side Only — Never commit actual secrets)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Optional Default Provider & Model
DEFAULT_PROVIDER=
DEFAULT_MODEL=
