# ==============================================================================
# Unified AI Assistant - Production Environment Configuration Template
# ==============================================================================
# Copy this file to .env.production on deployment servers and populate all secrets.
# NEVER commit production .env or .env.production files containing real secrets to Git.

# --- Core Environment & Security ---
IS_PRODUCTION=true
AUTH_MODE=jwt
ALLOW_DEV_AUTH=false

# Generate a high-entropy secret (e.g., openssl rand -hex 32)
JWT_SECRET_KEY=replace_with_at_least_32_characters_cryptographically_secure_key
JWT_ALGORITHM=HS256
JWT_ISSUER=unified-ai-assistant
JWT_AUDIENCE=unified-ai-assistant-users

# --- PostgreSQL Database ---
POSTGRES_DB=unified_ai
POSTGRES_USER=unified_ai
POSTGRES_PASSWORD=replace_with_strong_database_password
DATABASE_URL=postgresql+asyncpg://unified_ai:replace_with_strong_database_password@db:5432/unified_ai

# --- Network & Ingress Hardening ---
# Specify exact production domain(s)
CORS_ORIGINS=["https://assistant.example.com"]
RATE_LIMIT_PER_MINUTE=120
MAX_REQUEST_BODY_BYTES=15728640

# --- Autonomous Browser Execution Boundary ---
BROWSER_HEADLESS=true
ALLOW_LOCAL_BROWSER_TARGETS=false
BROWSER_WORKER_CONCURRENCY=3

# --- Hosted AI Model Providers (Kept Server-Side) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# --- Web Research Search Providers ---
TAVILY_API_KEY=
PERPLEXITY_API_KEY=
